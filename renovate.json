{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "platform": "github",
  "repositories": ["petedillo/blog-gitops"],
  "kubernetes": {
    "fileMatch": ["kubernetes/.+\\.yaml$"]
  },
  "packageRules": [
    {
      "description": "Auto-merge blog-api and blog-ui image updates",
      "matchPackagePatterns": ["^docker.toastedbytes.com/blog-"],
      "matchUpdateTypes": ["digest", "pin"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ],
  "docker": {
    "pinDigests": true
  }
}
