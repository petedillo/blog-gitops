{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "kubernetes": {
    "fileMatch": ["kubernetes/.+\\.yaml$"]
  },
  "hostRules": [
    {
      "matchHost": "docker.toastedbytes.com",
      "username": "{{ secrets.RENOVATE_DOCKER_USERNAME }}",
      "password": "{{ secrets.RENOVATE_DOCKER_PASSWORD }}"
    }
  ],
  "packageRules": [
    {
      "description": "Auto-merge blog-api and blog-ui image updates",
      "matchPackagePatterns": ["^docker.toastedbytes.com/blog-"],
      "matchUpdateTypes": ["digest", "pin"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ],
  "docker": {
    "pinDigests": true
  }
}
